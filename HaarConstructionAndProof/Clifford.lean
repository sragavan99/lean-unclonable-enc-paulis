import PauliConstructionAndProof.Pauli
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Star.CHSH

/-!
# The finite-dimensional Clifford subgroup

The Pauli subgroup is the subgroup generated by the phase-free Hermitian
Paulis.  Thus it contains the usual scalar phases generated by Pauli products.
The Clifford subgroup is defined extensionally as its normalizer inside the
matrix unitary group.

For the Haar reduction we prove the only Clifford transitivity fact that is
needed: on a positive number of qubits, the first `Z` Pauli is conjugate, with
positive sign, to every nonidentity phase-free Pauli.  The conjugators are
products of normalized bisectors `(A+B)/sqrt 2` of anticommuting Hermitian
Paulis.  Direct Pauli commutation algebra proves that every such bisector lies
in the normalizer.
-/

open scoped ComplexOrder MatrixOrder

namespace UE.HaarConstructionAndProof

open QIT UE.PauliConstructionAndProof

noncomputable section

set_option maxHeartbeats 1000000

/-- A phase-free Pauli as an element of the matrix unitary group. -/
def pauliUnitary {q : ℕ} (v : PauliLabel q) :
    Matrix.unitaryGroup (Fin (2 ^ q)) ℂ :=
  ⟨pauli v, pauli_mem_unitaryGroup v⟩

@[simp]
theorem pauliUnitary_coe {q : ℕ} (v : PauliLabel q) :
    (pauliUnitary v : CMatrix (Fin (2 ^ q))) = pauli v :=
  rfl

/-- The finite Pauli group, including the scalar phases generated by products
of phase-free Hermitian Paulis. -/
def pauliSubgroup (q : ℕ) :
    Subgroup (Matrix.unitaryGroup (Fin (2 ^ q)) ℂ) :=
  Subgroup.closure (Set.range (pauliUnitary (q := q)))

/-- The `q`-qubit Clifford group, extensionally defined as the normalizer of
the Pauli group in the full matrix unitary group. -/
def cliffordSubgroup (q : ℕ) :
    Subgroup (Matrix.unitaryGroup (Fin (2 ^ q)) ℂ) :=
  Subgroup.normalizer (pauliSubgroup q)

theorem pauliUnitary_mem_pauliSubgroup {q : ℕ} (v : PauliLabel q) :
    pauliUnitary v ∈ pauliSubgroup q :=
  Subgroup.subset_closure ⟨v, rfl⟩

/-- The normalized bisector of two anticommuting Pauli reflections. -/
def pauliBisector {q : ℕ} (a b : PauliLabel q) :
    CMatrix (Fin (2 ^ q)) :=
  (Real.sqrt 2)⁻¹ • (pauli a + pauli b)

private theorem half_smul_two_mul {q : ℕ}
    (X : CMatrix (Fin (2 ^ q))) :
    (2 : ℝ)⁻¹ • (2 * X) = X := by
  rw [show (2 : CMatrix (Fin (2 ^ q))) = 1 + 1 by norm_num,
    Matrix.add_mul, Matrix.one_mul]
  ext i j
  simp only [Matrix.smul_apply, Matrix.add_apply, Complex.real_smul]
  push_cast
  ring

theorem pauliBisector_isHermitian {q : ℕ} (a b : PauliLabel q) :
    (pauliBisector a b).IsHermitian := by
  rw [Matrix.IsHermitian, pauliBisector, Matrix.conjTranspose_smul,
    Matrix.conjTranspose_add, pauli_isHermitian, pauli_isHermitian]
  simp

theorem pauliBisector_mul_self {q : ℕ} (a b : PauliLabel q)
    (hab : symplectic q a b = true) :
    pauliBisector a b * pauliBisector a b = 1 := by
  have hanti := pauli_commutation a b
  rw [hab] at hanti
  simp only [commutationSign_true, neg_smul, one_smul] at hanti
  simp only [pauliBisector, Algebra.smul_mul_assoc,
    Algebra.mul_smul_comm, ← mul_smul,
    TsirelsonInequality.sqrt_two_inv_mul_self]
  simp only [Matrix.add_mul, Matrix.mul_add]
  noncomm_ring [pauli_mul_self a, pauli_mul_self b, hanti]
  simpa using (half_smul_two_mul (q := q) (1 : CMatrix (Fin (2 ^ q))))

/-- The normalized Pauli bisector as a bundled unitary. -/
def pauliBisectorUnitary {q : ℕ} (a b : PauliLabel q)
    (hab : symplectic q a b = true) :
    Matrix.unitaryGroup (Fin (2 ^ q)) ℂ := by
  refine ⟨pauliBisector a b, ?_⟩
  rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose,
    pauliBisector_isHermitian]
  exact pauliBisector_mul_self a b hab

@[simp]
theorem pauliBisectorUnitary_coe {q : ℕ} (a b : PauliLabel q)
    (hab : symplectic q a b = true) :
    (pauliBisectorUnitary a b hab : CMatrix (Fin (2 ^ q))) =
      pauliBisector a b :=
  rfl

theorem pauliBisector_conj_left {q : ℕ} (a b : PauliLabel q)
    (hab : symplectic q a b = true) :
    pauliBisector a b * pauli a * star (pauliBisector a b) = pauli b := by
  rw [Matrix.star_eq_conjTranspose, pauliBisector_isHermitian]
  have hanti := pauli_commutation a b
  rw [hab] at hanti
  simp only [commutationSign_true, neg_smul, one_smul] at hanti
  simp only [pauliBisector, Algebra.smul_mul_assoc,
    Algebra.mul_smul_comm, ← mul_smul,
    TsirelsonInequality.sqrt_two_inv_mul_self]
  simp only [Matrix.add_mul, Matrix.mul_add]
  noncomm_ring [pauli_mul_self a, pauli_mul_self b, hanti]
  rw [← Matrix.mul_assoc, pauli_mul_self b, Matrix.one_mul]
  ext i j
  simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.neg_apply,
    Complex.real_smul]
  push_cast
  ring

/-- Two anticommuting-bisector conjugations compose exactly, with no residual
phase. -/
theorem pauliBisector_comp_conj_left {q : ℕ} (a b c : PauliLabel q)
    (hab : symplectic q a b = true) (hbc : symplectic q b c = true) :
    ((pauliBisectorUnitary b c hbc * pauliBisectorUnitary a b hab :
          Matrix.unitaryGroup (Fin (2 ^ q)) ℂ) : CMatrix (Fin (2 ^ q))) *
        pauli a *
        star ((pauliBisectorUnitary b c hbc * pauliBisectorUnitary a b hab :
          Matrix.unitaryGroup (Fin (2 ^ q)) ℂ) : CMatrix (Fin (2 ^ q))) =
      pauli c := by
  change
    (pauliBisector b c * pauliBisector a b) * pauli a *
        star (pauliBisector b c * pauliBisector a b) = pauli c
  rw [star_mul, Matrix.star_eq_conjTranspose, pauliBisector_isHermitian,
    Matrix.star_eq_conjTranspose, pauliBisector_isHermitian]
  have h₁ := pauliBisector_conj_left a b hab
  rw [Matrix.star_eq_conjTranspose, pauliBisector_isHermitian] at h₁
  have h₂ := pauliBisector_conj_left b c hbc
  rw [Matrix.star_eq_conjTranspose, pauliBisector_isHermitian] at h₂
  calc
    pauliBisector b c * pauliBisector a b * pauli a *
          (pauliBisector a b * pauliBisector b c) =
        pauliBisector b c *
          (pauliBisector a b * pauli a * pauliBisector a b) *
          pauliBisector b c := by noncomm_ring
    _ = pauliBisector b c * pauli b * pauliBisector b c := by rw [h₁]
    _ = pauli c := h₂

private theorem pauliBisector_conj_generator {q : ℕ}
    (a b c : PauliLabel q) (hab : symplectic q a b = true) :
    ∃ x ∈ pauliSubgroup q,
      (x : CMatrix (Fin (2 ^ q))) =
        pauliBisector a b * pauli c * star (pauliBisector a b) := by
  rw [Matrix.star_eq_conjTranspose, pauliBisector_isHermitian]
  have hab' := pauli_commutation a b
  rw [hab] at hab'
  simp only [commutationSign_true, neg_smul, one_smul] at hab'
  have hac := pauli_commutation a c
  have hbc := pauli_commutation b c
  cases hacv : symplectic q a c <;> cases hbcv : symplectic q b c
  · rw [hacv] at hac
    rw [hbcv] at hbc
    simp only [commutationSign_false, one_smul] at hac hbc
    refine ⟨pauliUnitary c, pauliUnitary_mem_pauliSubgroup c, ?_⟩
    simp only [pauliBisector, Algebra.smul_mul_assoc,
      Algebra.mul_smul_comm, ← mul_smul,
      TsirelsonInequality.sqrt_two_inv_mul_self, pauliUnitary_coe]
    simp only [Matrix.add_mul, Matrix.mul_add]
    noncomm_ring [pauli_mul_self a, pauli_mul_self b, hac, hbc]
    rw [hab']
    simp only [mul_neg, smul_neg]
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.neg_apply,
      Complex.real_smul]
    push_cast
    ring
  · rw [hacv] at hac
    rw [hbcv] at hbc
    simp only [commutationSign_false, commutationSign_true,
      one_smul, neg_smul] at hac hbc
    let x := pauliUnitary b * pauliUnitary a * pauliUnitary c
    have hx : x ∈ pauliSubgroup q :=
      (pauliSubgroup q).mul_mem
        ((pauliSubgroup q).mul_mem (pauliUnitary_mem_pauliSubgroup b)
          (pauliUnitary_mem_pauliSubgroup a))
        (pauliUnitary_mem_pauliSubgroup c)
    refine ⟨x, hx, ?_⟩
    change pauli b * pauli a * pauli c = _
    simp only [pauliBisector, Algebra.smul_mul_assoc,
      Algebra.mul_smul_comm, ← mul_smul,
      TsirelsonInequality.sqrt_two_inv_mul_self]
    simp only [Matrix.add_mul, Matrix.mul_add]
    noncomm_ring [pauli_mul_self a, pauli_mul_self b, hab', hac, hbc]
    rw [← Matrix.mul_assoc, hbc, neg_mul]
    rw [Matrix.mul_assoc]
    ext i j
    simp only [Matrix.smul_apply, Matrix.neg_apply, Complex.real_smul]
    push_cast
    ring
  · rw [hacv] at hac
    rw [hbcv] at hbc
    simp only [commutationSign_true, commutationSign_false,
      one_smul, neg_smul] at hac hbc
    let x := pauliUnitary a * pauliUnitary b * pauliUnitary c
    have hx : x ∈ pauliSubgroup q :=
      (pauliSubgroup q).mul_mem
        ((pauliSubgroup q).mul_mem (pauliUnitary_mem_pauliSubgroup a)
          (pauliUnitary_mem_pauliSubgroup b))
        (pauliUnitary_mem_pauliSubgroup c)
    refine ⟨x, hx, ?_⟩
    change pauli a * pauli b * pauli c = _
    simp only [pauliBisector, Algebra.smul_mul_assoc,
      Algebra.mul_smul_comm, ← mul_smul,
      TsirelsonInequality.sqrt_two_inv_mul_self]
    simp only [Matrix.add_mul, Matrix.mul_add]
    noncomm_ring [pauli_mul_self a, pauli_mul_self b, hab', hac, hbc]
    rw [← Matrix.mul_assoc, hbc, Matrix.mul_assoc]
    ext i j
    simp only [Matrix.smul_apply, Complex.real_smul]
    push_cast
    ring
  · rw [hacv] at hac
    rw [hbcv] at hbc
    simp only [commutationSign_true, neg_smul] at hac hbc
    let x := pauliUnitary a * pauliUnitary b * pauliUnitary a *
      pauliUnitary b * pauliUnitary c
    have hx : x ∈ pauliSubgroup q := by
      exact (pauliSubgroup q).mul_mem
        ((pauliSubgroup q).mul_mem
          ((pauliSubgroup q).mul_mem
            ((pauliSubgroup q).mul_mem (pauliUnitary_mem_pauliSubgroup a)
              (pauliUnitary_mem_pauliSubgroup b))
            (pauliUnitary_mem_pauliSubgroup a))
          (pauliUnitary_mem_pauliSubgroup b))
        (pauliUnitary_mem_pauliSubgroup c)
    refine ⟨x, hx, ?_⟩
    change pauli a * pauli b * pauli a * pauli b * pauli c = _
    simp only [pauliBisector, Algebra.smul_mul_assoc,
      Algebra.mul_smul_comm, ← mul_smul,
      TsirelsonInequality.sqrt_two_inv_mul_self]
    simp only [Matrix.add_mul, Matrix.mul_add]
    noncomm_ring [pauli_mul_self a, pauli_mul_self b, hab', hac, hbc]
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.neg_apply,
      Complex.real_smul]
    push_cast
    ring

private theorem pauliBisector_conj_pauliSubgroup {q : ℕ}
    (a b : PauliLabel q) (hab : symplectic q a b = true)
    (x : Matrix.unitaryGroup (Fin (2 ^ q)) ℂ) (hx : x ∈ pauliSubgroup q) :
    pauliBisectorUnitary a b hab * x * (pauliBisectorUnitary a b hab)⁻¹ ∈
      pauliSubgroup q := by
  let g := pauliBisectorUnitary a b hab
  let φ : Matrix.unitaryGroup (Fin (2 ^ q)) ℂ →*
      Matrix.unitaryGroup (Fin (2 ^ q)) ℂ :=
    (MulAut.conj g).toMonoidHom
  have hle : pauliSubgroup q ≤ (pauliSubgroup q).comap φ := by
    rw [pauliSubgroup, Subgroup.closure_le]
    rintro _ ⟨c, rfl⟩
    change φ (pauliUnitary c) ∈ pauliSubgroup q
    change g * pauliUnitary c * g⁻¹ ∈ pauliSubgroup q
    rcases pauliBisector_conj_generator a b c hab with ⟨y, hy, hmatrix⟩
    have hcoe :
        ((g * pauliUnitary c * g⁻¹ :
            Matrix.unitaryGroup (Fin (2 ^ q)) ℂ) : CMatrix (Fin (2 ^ q))) =
          (y : CMatrix (Fin (2 ^ q))) := by
      change pauliBisector a b * pauli c * star (pauliBisector a b) = _
      exact hmatrix.symm
    have hxy : g * pauliUnitary c * g⁻¹ = y := Subtype.ext hcoe
    rw [hxy]
    exact hy
  exact hle hx

/-- Every normalized bisector of two anticommuting Paulis is a Clifford
unitary. -/
theorem pauliBisectorUnitary_mem_clifford {q : ℕ}
    (a b : PauliLabel q) (hab : symplectic q a b = true) :
    pauliBisectorUnitary a b hab ∈ cliffordSubgroup q := by
  rw [cliffordSubgroup, Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact pauliBisector_conj_pauliSubgroup a b hab x
  · intro hx
    let g := pauliBisectorUnitary a b hab
    have hgself : g⁻¹ = g := by
      apply Subtype.ext
      change star (pauliBisector a b) = pauliBisector a b
      exact pauliBisector_isHermitian a b
    have hg2 : g * g = 1 := by
      calc
        g * g = g⁻¹ * g := by rw [hgself]
        _ = 1 := inv_mul_cancel g
    have hconj := pauliBisector_conj_pauliSubgroup a b hab
      (g * x * g⁻¹) hx
    have heq : g * (g * x * g⁻¹) * g⁻¹ = x := by
      rw [hgself]
      calc
        g * (g * x * g) * g = (g * g) * x * (g * g) := by group
        _ = x := by rw [hg2]; simp
    rw [heq] at hconj
    exact hconj

/-- A nonzero symplectic vector has a symplectic partner. -/
theorem exists_symplectic_true {q : ℕ} (v : PauliLabel q)
    (hv : v ≠ zeroLabel q) :
    ∃ w : PauliLabel q, symplectic q w v = true := by
  induction q with
  | zero =>
      exfalso
      apply hv
      cases v
      rfl
  | succ q ih =>
      rcases v with ⟨⟨x, z⟩, tail⟩
      cases x <;> cases z
      · have htail : tail ≠ zeroLabel q := by
          intro htail
          apply hv
          simp [zeroLabel, htail]
        rcases ih tail htail with ⟨w, hw⟩
        refine ⟨((false, false), w), ?_⟩
        simp [symplectic, singleSymplectic, hw]
      · refine ⟨((true, false), zeroLabel q), ?_⟩
        simp [symplectic, singleSymplectic]
      · refine ⟨((false, true), zeroLabel q), ?_⟩
        simp [symplectic, singleSymplectic]
      · refine ⟨((true, false), zeroLabel q), ?_⟩
        simp [symplectic, singleSymplectic]

/-- If a nonidentity Pauli commutes with the first `Z`, then either it is that
`Z` or there is a Pauli anticommuting with both. -/
theorem exists_common_anticommuting_of_firstZ_commutes (q : ℕ)
    (v : PauliLabel (q + 1))
    (hv : v ≠ zeroLabel (q + 1))
    (hcomm : symplectic (q + 1) (firstZLabel q) v = false)
    (hne : v ≠ firstZLabel q) :
    ∃ w : PauliLabel (q + 1),
      symplectic (q + 1) (firstZLabel q) w = true ∧
      symplectic (q + 1) w v = true := by
  rcases v with ⟨⟨x, z⟩, tail⟩
  have hx : x = false := by
    simpa [firstZLabel, symplectic, singleSymplectic] using hcomm
  subst x
  cases z
  · have htail : tail ≠ zeroLabel q := by
      intro ht
      apply hv
      simp [zeroLabel, ht]
    rcases exists_symplectic_true tail htail with ⟨w, hw⟩
    refine ⟨((true, false), w), ?_, ?_⟩
    · simp [firstZLabel, symplectic, singleSymplectic]
    · simp [symplectic, singleSymplectic, hw]
  · refine ⟨firstXLabel q, ?_, ?_⟩
    · simp [firstZLabel, firstXLabel, symplectic, singleSymplectic]
    · simp [firstXLabel, symplectic, singleSymplectic]

/-- Clifford transitivity on `q + 1` qubits with the positive sign
required by the ciphertext identity in the Haar reduction. -/
theorem exists_clifford_conjugates_firstZ (q : ℕ)
    (k : PauliKey (q + 1)) :
    ∃ U : Matrix.unitaryGroup (Fin (2 ^ (q + 1))) ℂ,
      U ∈ cliffordSubgroup (q + 1) ∧
      (U : CMatrix (Fin (2 ^ (q + 1)))) * pauli (firstZLabel q) *
          star (U : CMatrix (Fin (2 ^ (q + 1)))) = pauli k.1 := by
  by_cases heq : k.1 = firstZLabel q
  · refine ⟨1, (cliffordSubgroup (q + 1)).one_mem, ?_⟩
    simp [heq]
  by_cases hanti : symplectic (q + 1) (firstZLabel q) k.1 = true
  · let U := pauliBisectorUnitary (firstZLabel q) k.1 hanti
    refine ⟨U, pauliBisectorUnitary_mem_clifford _ _ hanti, ?_⟩
    exact pauliBisector_conj_left (firstZLabel q) k.1 hanti
  · have hcomm : symplectic (q + 1) (firstZLabel q) k.1 = false := by
      cases h : symplectic (q + 1) (firstZLabel q) k.1
      · rfl
      · exact (hanti h).elim
    rcases exists_common_anticommuting_of_firstZ_commutes q k.1 k.2 hcomm heq with
      ⟨w, hZw, hwk⟩
    let U₁ := pauliBisectorUnitary (firstZLabel q) w hZw
    let U₂ := pauliBisectorUnitary w k.1 hwk
    refine ⟨U₂ * U₁, ?_, ?_⟩
    · exact (cliffordSubgroup (q + 1)).mul_mem
        (pauliBisectorUnitary_mem_clifford w k.1 hwk)
        (pauliBisectorUnitary_mem_clifford (firstZLabel q) w hZw)
    · exact pauliBisector_comp_conj_left (firstZLabel q) w k.1 hZw hwk

end

end UE.HaarConstructionAndProof
